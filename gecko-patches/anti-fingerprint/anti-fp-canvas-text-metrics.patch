+    // precision — a high-entropy fingerprint. When RFP is active, quantize every
+    // exposed metric to whole CSS pixels so it is uniform across users/platforms.
+    // Uniform, never randomized (randomizing would split the RFP cohort).
+    // Cover BOTH the document-backed canvas and the OffscreenCanvas (worker /
+    // transferControlToOffscreen) path, which has no mCanvasElement.
+    bool rfpText = false;
+    if (mCanvasElement) {
