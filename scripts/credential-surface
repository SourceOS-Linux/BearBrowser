#!/usr/bin/env bash
set -euo pipefail

echo "BearBrowser credential surface"
echo "expected secrets: none currently declared"
echo "redaction: required"

echo
echo "configured credential-adjacent paths:"
for p in "$HOME/.config/bearbrowser" "$HOME/.local/state/bearbrowser" "$HOME/.cache/bearbrowser" "$HOME/Library/Application Support/BearBrowser"; do
  if [ -e "$p" ]; then
    echo "  exists: $p"
    find "$p" -maxdepth 2 -type f 2>/dev/null | sed 's#^#    file: #' | sed -E 's/(token|key|secret|password|auth|oauth|ssh)/<redacted-name>/Ig'
  else
    echo "  missing: $p"
  fi
done

echo
echo "policy: declare any future SSH-agent, OAuth, keychain, model-provider, or API-key authority in TRUST_SURFACE.yaml"
