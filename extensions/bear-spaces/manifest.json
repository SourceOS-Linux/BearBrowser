{
  "manifest_version": 2,
  "name": "Bear Spaces",
  "version": "1.0.0",
  "description": "Named tab workspaces for BearBrowser — close the Arc Spaces gap.",
  "author": "mdheller",
  "license": "MIT",

  "permissions": [
    "tabs",
    "tabHide",
    "storage",
    "contextMenus",
    "nativeMessaging"
  ],

  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },

  "sidebar_action": {
    "default_title": "Bear Spaces",
    "default_panel": "sidebar.html",
    "default_icon": {
      "16": "icons/spaces-16.svg",
      "32": "icons/spaces-32.svg",
      "48": "icons/spaces-48.svg"
    }
  },

  "icons": {
    "16": "icons/spaces-16.svg",
    "32": "icons/spaces-32.svg",
    "48": "icons/spaces-48.svg",
    "96": "icons/spaces-96.svg"
  },

  "browser_action": {
    "default_title": "Bear Spaces",
    "default_icon": {
      "16": "icons/spaces-16.svg",
      "32": "icons/spaces-32.svg",
      "48": "icons/spaces-48.svg"
    }
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "bear-spaces@bearbrowser.local",
      "strict_min_version": "114.0"
    }
  }
}
