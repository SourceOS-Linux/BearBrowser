{
  "app-id": "ai.sourceos.BearBrowser",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "23.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "bearbrowser",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=x11",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--device=dri",
    "--filesystem=home",
    "--filesystem=xdg-download",
    "--persist=.bearbrowser",
    "--env=HOME_URL=about:blank",
    "--env=STARTUP_HOMEPAGE=about:blank",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.gtk.vfs.*",
    "--own-name=org.bearbrowser.*"
  ],
  "modules": [
    {
      "name": "bearbrowser",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/lib/bearbrowser",
        "cp -a bin /app/lib/bearbrowser/bin",
        "install -Dm644 user.js /app/lib/bearbrowser/defaults/profile/user.js",
        "printf '#!/bin/sh\\nexec /app/lib/bearbrowser/bin/bearbrowser --profile ~/.bearbrowser/profiles/default \"$@\"' > /app/bin/bearbrowser && chmod 755 /app/bin/bearbrowser",
        "install -Dm644 bearbrowser.desktop /app/share/applications/ai.sourceos.BearBrowser.desktop",
        "install -Dm644 bearbrowser.svg /app/share/icons/hicolor/scalable/apps/ai.sourceos.BearBrowser.svg"
      ],
      "sources": [
        {
          "_comment": "Real Linux x86_64 human-secure build 140.12.0esr-1. Source of truth: gs://sourceos-artifacts-socioprophet/bearbrowser-builds/bearbrowser-build-20260630-100322/artifacts/bearbrowser-human-secure-linux-x86_64.tar.gz",
          "type": "archive",
          "url": "https://downloads.sourceos.dev/bearbrowser/140.12.0esr-1/bearbrowser-human-secure-linux-x86_64.tar.gz",
          "sha256": "a94bda8c5e51122f578b53b1df01ddd9de7af12dc0ab40815eb4c4b1347bc7fb",
          "strip-components": 0
        },
        {
          "type": "file",
          "path": "../../../profiles/default/user.js",
          "dest-filename": "user.js"
        },
        {
          "type": "file",
          "path": "../bearbrowser.desktop"
        },
        {
          "type": "file",
          "path": "../../branding/bearbrowser.svg",
          "dest-filename": "bearbrowser.svg"
        }
      ]
    }
  ]
}
