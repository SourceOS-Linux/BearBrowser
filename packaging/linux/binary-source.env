# BearBrowser Linux x86_64 binary source — single source of truth for packaging.
# First successful build: bearbrowser-build-20260630-100322 (Mozilla BearBrowser 140.12.0esr-1).
# Consumed by deb/snap/appimage/flatpak/rpm packaging to fetch the REAL binary tarball.
#
# Each tarball extracts to a top-level bin/ directory containing the full Gecko
# runtime; the launcher executable is bin/bearbrowser.

BEARBROWSER_VERSION="0.1.0"
BEARBROWSER_UPSTREAM_REF="140.12.0esr-1"
BEARBROWSER_BUILD_ID="bearbrowser-build-20260630-100322"

# GCS source of truth (gcloud auth required to fetch).
BEARBROWSER_GCS_BASE="gs://sourceos-artifacts-socioprophet/bearbrowser-builds/bearbrowser-build-20260630-100322/artifacts"

# human-secure variant (default ship target)
BEARBROWSER_HUMAN_TARBALL="bearbrowser-human-secure-linux-x86_64.tar.gz"
BEARBROWSER_HUMAN_SHA256="a94bda8c5e51122f578b53b1df01ddd9de7af12dc0ab40815eb4c4b1347bc7fb"

# tor-mode variant (second variant)
BEARBROWSER_TOR_TARBALL="bearbrowser-tor-mode-linux-x86_64.tar.gz"
BEARBROWSER_TOR_SHA256="0f29fc07448f5cb549d919458dedeefc50cd147063515cd7e77862ed8a1c56ad"

# Launcher path inside the extracted tarball.
BEARBROWSER_LAUNCHER_REL="bin/bearbrowser"
