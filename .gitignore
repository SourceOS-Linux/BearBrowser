# BearBrowser generated workspaces
build/
dist/
out/
.cache/
*.log

# Python bytecode cache
__pycache__/
*.pyc
*.pyo

# Local editor/system files
.DS_Store
.idea/
.vscode/

# Rust build output
capture-sidecar/target/
iot-sidecar/target/

# GeoIP city DB is large (131MB) — staged at build time, not committed
capture-sidecar/geoip/dbip-city-lite.mmdb

# Audit harness OUTPUT — machine-specific measurement snapshots. Never commit:
# they capture the running machine's fingerprint surface (real core count,
# canvas hash, screen metrics). Regenerate with scripts/audit/ instead.
scripts/audit/*report*.json
scripts/audit/probe.html
scripts/audit/*.log
