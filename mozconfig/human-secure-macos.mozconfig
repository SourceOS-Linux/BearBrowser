# BearBrowser — human-secure profile mozconfig for macOS (LibreWolf-derived)
#
# The build driver (scripts/build-macos-local.sh) copies THIS file over the
# LibreWolf mirror's $workspace/source/assets/mozconfig so mach targets Cocoa
# instead of the mirror's default GTK.
ac_add_options --enable-application=browser
ac_add_options --enable-optimize
ac_add_options --disable-debug
ac_add_options --enable-release
ac_add_options --enable-rust-simd
ac_add_options --disable-tests
ac_add_options --disable-crashreporter
ac_add_options --disable-updater
ac_add_options --without-wasm-sandboxed-libraries
ac_add_options --with-app-name=bearbrowser
ac_add_options --with-app-basename=BearBrowser
ac_add_options --with-distribution-id=ai.sourceos.bearbrowser
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-bearbrowser-human-secure
# getconf works on both macOS and Linux; nproc does not exist on macOS.
mk_add_options MOZ_MAKE_FLAGS="-j$(getconf _NPROCESSORS_ONLN)"
export MOZ_TELEMETRY_REPORTING=
export MOZ_DATA_REPORTING=
export MOZ_REQUIRE_SIGNING=
# Human-secure on macOS: native Cocoa toolkit, Widevine for streaming.
ac_add_options --enable-default-toolkit=cairo-cocoa
ac_add_options --enable-eme=widevine
# Pin to the platform floor we support. macOS 11 is the oldest Apple still ships
# security updates for; matching it keeps our arm64/x86_64 output loadable on all
# actively-supported Macs without forcing a 26.x-only binary.
# macOS SDK: the build driver appends `--with-macos-sdk=<xcrun --show-sdk-path>`
# so we use the SYSTEM Xcode SDK. Mozilla's pinned SDK toolchain artifact is
# access-restricted (unpack-sdk.py 403s outside Mozilla CI — Apple's SDK can't be
# publicly redistributed). Do NOT set --enable-macos-sdk (not a valid option).
export MACOSX_DEPLOYMENT_TARGET=11.0
