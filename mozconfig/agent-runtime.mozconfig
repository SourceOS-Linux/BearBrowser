# BearBrowser — agent-runtime profile mozconfig (LibreWolf-derived)
ac_add_options --enable-application=browser
ac_add_options --enable-optimize
ac_add_options --disable-debug
ac_add_options --enable-release
ac_add_options --enable-rust-simd
ac_add_options --disable-tests
# Crash reporter: ENABLED so native crashes actually leave evidence.
# It was disabled here, which is why a crash produced NO .ips, NO minidump
# and no Console.app entry — the app just vanished and we had nothing to
# debug. Enabling it does NOT send anything: submission is off by default and
# our profiles set breakpad.reportURL="" + browser.tabs.crashReporting
# .sendReport=false, so reports stay LOCAL (minidumps under the profile's
# crashes/ dir). Windows keeps it disabled — breakpad there uses a removed
# MSVC stdext API and fails the cross build (see human-secure-win64).
ac_add_options --enable-crashreporter
ac_add_options --disable-updater
ac_add_options --without-wasm-sandboxed-libraries
ac_add_options --with-app-name=bearbrowser
ac_add_options --with-app-basename=BearBrowser
ac_add_options --with-distribution-id=ai.sourceos.bearbrowser
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-bearbrowser-agent-runtime
mk_add_options MOZ_MAKE_FLAGS="-j$(nproc)"
export MOZ_TELEMETRY_REPORTING=
export MOZ_DATA_REPORTING=
export MOZ_REQUIRE_SIGNING=
# Agent-runtime: headless-friendly, automation surface
ac_add_options --enable-default-toolkit=cairo-gtk3-wayland
