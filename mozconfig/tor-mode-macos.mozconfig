# BearBrowser — tor-mode profile mozconfig for macOS (LibreWolf-derived)
#
# The build driver copies THIS file over $workspace/source/assets/mozconfig for
# tor-mode. apply-sourceos-overlays.sh then APPENDS the
# -DBEARBROWSER_FORCE_WIN_SPOOF CXX flag so the OS-spoof patch takes effect at
# compile time. Do NOT add Widevine here: tor cohort ships without EME.
ac_add_options --enable-application=browser
ac_add_options --enable-optimize
ac_add_options --disable-debug
ac_add_options --enable-release
ac_add_options --enable-rust-simd
ac_add_options --disable-tests
ac_add_options --disable-crashreporter
ac_add_options --disable-updater
ac_add_options --without-wasm-sandboxed-libraries
ac_add_options --with-app-name=bearbrowser
ac_add_options --with-app-basename=BearBrowser
ac_add_options --with-distribution-id=ai.sourceos.bearbrowser
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-bearbrowser-tor-mode
mk_add_options MOZ_MAKE_FLAGS="-j$(getconf _NPROCESSORS_ONLN)"
export MOZ_TELEMETRY_REPORTING=
export MOZ_DATA_REPORTING=
export MOZ_REQUIRE_SIGNING=
# Tor-mode on macOS: native Cocoa, no EME (cohort match).
ac_add_options --enable-default-toolkit=cairo-cocoa
# Fetch toolchains during `mach build` (fork-compatible) instead of `mach
# bootstrap` (mozilla-central-only). SDK served locally by our unpack-sdk shim.
ac_add_options --enable-bootstrap
# macOS SDK: the driver appends --with-macos-sdk=<xcrun --show-sdk-path> (system
# SDK). Mozilla's pinned SDK artifact 403s outside their CI. Not --enable-macos-sdk.
export MACOSX_DEPLOYMENT_TARGET=11.0
